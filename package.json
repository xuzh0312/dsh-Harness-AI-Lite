{
  "name": "@local/dsh-harness-workspace-win",
  "private": true,
  "type": "module",
  "description": "Create a Harness workspace from four existing directories.",
  "scripts": {
    "test": "node --check index.cjs && node --check workspace.cjs && node --check client.js && node --test --test-isolation=none workspace.test.cjs"
  },
  "exports": {
    ".": "./index.cjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.cjs",
    "workspace.cjs",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "template",
    "seeds",
    "icon.svg",
    "README.en.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remote-access"
      ]
    }
  },
  "license": "MIT"
}
